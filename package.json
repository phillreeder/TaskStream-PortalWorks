{
  "name": "taskstream",
  "version": "0.0.1",
  "description": "Deterministic, observable, and auditable browser and document automation workflows.",
  "license": "UNLICENSED",
  "author": "Phillip Reeder",
  "type": "module",
  "module": "NodeNext",
  "directories": {},
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "execution-worker:dev": "tsx src/services/execution-worker/main.ts",
    "execution-worker:start": "node dist/src/services/execution-worker/main.js",
    "planner:dev": "tsx src/services/planner/main.ts",
    "planner:start": "node dist/src/services/planner/main.js",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:allure": "node ./scripts/test-with-allure.mjs",
    "test:allure:watch": "node ./scripts/test-allure-watch.mjs",
    "test:allure:watch:no-db": "node ./scripts/test-allure-watch.mjs --no-db",
    "test:allure:open": "node ./scripts/open-allure-report.mjs",
    "test:harness:list": "node ./scripts/test-harness.mjs list",
    "test:harness:run": "node ./scripts/test-harness.mjs run",
    "test:harness:verify": "node ./scripts/test-harness.mjs verify && node --test tests/harness/harness.test.mjs",
    "test:harness:allure": "node ./scripts/test-harness.mjs allure",
    "test:harness:allure:verify": "node ./scripts/test-harness.mjs verify-allure && node --test tests/harness/harness-allure.test.mjs",
    "test:harness:allure:serve": "node ./scripts/serve-harness-allure-report.mjs",
    "db:migrate:test": "cross-env-shell DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy",
    "db:reset:test": "cross-env-shell DATABASE_URL=$TEST_DATABASE_URL prisma migrate reset --force",
    "test:setup": "npm run db:reset:test && npm run db:migrate:test",
    "test:full": "npm run lint && npm run typecheck && npm run test:allure",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.cjs src packages",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "prisma:db:pull": "prisma db pull",
    "prisma:db:reset": "prisma migrate reset --force",
    "prisma:studio": "prisma studio",
    "poc:ieb-beta-api": "tsx src/poc/iebBetaApi.ts",
    "poc:test": "node --import tsx --test src/**/*.node.test.ts",
    "poc:dashboard:dev": "npm --prefix services/web-dashboard run dev",
    "poc:dashboard:build": "npm --prefix services/web-dashboard run build",
    "poc:dev": "concurrently -n api,planner,dashboard -c auto \"npm:poc:ieb-beta-api\" \"npm:planner:dev\" \"npm:poc:dashboard:dev\"",
    "scaffold:flat:watch": "tsx scripts/run-flat-scaffold.ts watch",
    "scaffold:flat": "tsx scripts/run-flat-scaffold.ts once"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "allure": "^3.0.0-beta.20",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0",
    "concurrently": "^9.2.0"
  },
  "dependencies": {
    "@prisma/client": "^7.4.2",
    "prisma": "^7.4.2",
    "@taskstream/web-automation": "workspace:*"
  },
  "workspaces": [
    "packages/*"
  ]
}
