    "prisma:db:reset": "prisma migrate reset --force",
    "prisma:studio": "prisma studio"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@TaskStream/SiteAutomation": "workspace:*",
