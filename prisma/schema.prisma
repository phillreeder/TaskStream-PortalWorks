generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlannerQueueStatus {
  pending
  locked
  completed
  failed
  dead_letter
}

enum RunStatus {
  created
  ready
  executing
  completed
  failed
}

model Task {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String?  @db.Uuid
  name        String
  description String?
  status      String   @default("active")
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycles      Cycle[]
  resources   Resource[]
  events      Event[]  @relation("EventTask")

  @@index([clientId])
  @@map("tasks")
}

model Cycle {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  status      String   @default("created")
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  streams     Stream[]
  events      Event[]  @relation("EventCycle")

  @@unique([taskId])
  @@index([status])
  @@map("cycles")
}

model Stream {
  id          String   @id @default(uuid()) @db.Uuid
  cycleId     String   @db.Uuid
  key         String
  status      String   @default("created")
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycle       Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  runs        Run[]
  resources   Resource[]
  events      Event[]  @relation("EventStream")

  @@unique([cycleId, key])
  @@index([status])
  @@map("streams")
}

model Run {
  id            String    @id @default(uuid()) @db.Uuid
  streamId      String    @db.Uuid
  status        RunStatus @default(created)
  payload       Json?
  result        Json?
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?

  stream        Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade)
  events        Event[]   @relation("EventRun")
  artifacts     Artifact[]
  logs          Log[]

  @@index([streamId])
  @@index([status])
  @@map("runs")
}

model Event {
  id            BigInt    @id @default(autoincrement())
  eventType     String
  payload       Json?
  causationId   String?   @db.Uuid
  correlationId String?   @db.Uuid
  createdAt     DateTime  @default(now())

  taskId        String?   @db.Uuid
  cycleId       String?   @db.Uuid
  streamId      String?   @db.Uuid
  runId         String?   @db.Uuid

  task          Task?     @relation("EventTask", fields: [taskId], references: [id], onDelete: Cascade)
  cycle         Cycle?    @relation("EventCycle", fields: [cycleId], references: [id], onDelete: Cascade)
  stream        Stream?   @relation("EventStream", fields: [streamId], references: [id], onDelete: Cascade)
  run           Run?      @relation("EventRun", fields: [runId], references: [id], onDelete: Cascade)

  @@index([eventType, id])
  @@index([taskId])
  @@index([cycleId])
  @@index([streamId])
  @@index([runId])
  @@index([createdAt])
  @@map("events")
}

model PlannerState {
  plannerType  String   @id
  lastEventId  BigInt   @default(0)
  meta         Json?
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("planner_state")
}

model PlannerQueue {
  id            String              @id @default(uuid()) @db.Uuid
  plannerType   String
  action        String
  entityType    String
  entityId      String              @db.Uuid
  payload       Json?
  priority      Int                 @default(0)
  runAt         DateTime            @default(now())
  expireAt      DateTime?
  status        PlannerQueueStatus  @default(pending)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(3)
  lockedBy      String?
  lockedAt      DateTime?
  causationId   String?             @db.Uuid
  correlationId String?             @db.Uuid
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, runAt, priority])
  @@index([plannerType])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@map("planner_queue")
}

model Resource {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String?  @db.Uuid
  streamId    String?  @db.Uuid
  kind        String
  status      String   @default("created")
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stream      Stream?  @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([streamId])
  @@index([kind])
  @@map("resources")
}

model Artifact {
  id          String   @id @default(uuid()) @db.Uuid
  runId       String   @db.Uuid
  kind        String
  path        String
  metadata    Json?
  createdAt   DateTime @default(now())

  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([kind])
  @@map("artifacts")
}

model Log {
  id          String   @id @default(uuid()) @db.Uuid
  runId       String?  @db.Uuid
  level       String
  message     String
  context     Json?
  createdAt   DateTime @default(now())

  run         Run?     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([level])
  @@index([createdAt])
  @@map("logs")
}

model Credential {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String?  @db.Uuid
  key         String
  value       String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@unique([clientId, key])
  @@map("credentials")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}
