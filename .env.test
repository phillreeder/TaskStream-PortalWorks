# Dedicated test database credentials; safe to commit for local orchestration only.
POSTGRES_USER=portalworks_test
POSTGRES_PASSWORD=portalworks_test
POSTGRES_DB=portalworks_test
POSTGRES_PORT=15433

# Local test database connection string (maps to postgres-test via host port 15433)
TEST_DATABASE_URL=postgresql://portalworks_test:portalworks_test@localhost:15433/portalworks_test?schema=public

# Container-internal connection string (platform-test rewrites DATABASE_URL to this value)
TEST_DATABASE_URL_DOCKER=postgresql://portalworks_test:portalworks_test@postgres-test:5432/portalworks_test?schema=public

# Port exposed by platform-test for Allure/Coverage HTTP server
TEST_REPORT_PORT=18080
