{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@TaskStream/SiteAutomation": [
        "packages/automation/index.ts"
      ],
      "@TaskStream/SiteAutomation/*": [
        "packages/automation/*"
      ],
      "@TaskStream/App/*": [
        "src/*"
      ],
      "@TaskStream/Tenants/*": [
        "Tenants/*"
      ]
    }
  },
  "include": [
    "src",
    "packages",
    "Tenants"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/automation/*"
  ]
}
