{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@TaskStream/App/*": [
        "src/*"
      ],
      "@TaskStream/Tenants/*": [
        "Tenants/*"
      ],
      "@taskstream/web-automation": [
        "packages/automation/src/index.ts"
      ],
      "@taskstream/web-automation/*": [
        "packages/automation/src/*"
      ],
      "@taskstream/web-automation/resources": [
        "packages/automation/src/resources/public.ts"
      ],
      "@taskstream/web-automation/playwright": [
        "packages/automation/src/playwright/index.ts"
      ],
      "@taskstream/web-automation/semantic": [
        "packages/automation/src/semantic/index.ts"
      ],
      "@taskstream/web-automation/recipes/linkedin": [
        "packages/automation/src/recipes/linkedin/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages",
    "Tenants"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/automation/*"
  ]
}
